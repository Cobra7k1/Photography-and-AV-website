---
// src/pages/calendario.astro
import ContactForm from '../components/ContactForm.astro';
import disponibilidadData from '../data/disponibilidad.json';
---

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Calendario - Reflections Audio Visual</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: #0a0a0a;
            color: #ffffff;
            min-height: 100vh;
            padding: 40px 20px;
        }

        .container {
            max-width: 800px;
            margin: 0 auto;
            padding: 40px 20px;
        }

        .header-calendar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding-bottom: 30px;
            border-bottom: 1px solid #333;
            margin-bottom: 40px;
        }

        .header-calendar h1 {
            font-size: 2rem;
            font-weight: 300;
            letter-spacing: 2px;
        }

        .header-calendar h1 i {
            color: #3b82f6;
            margin-right: 12px;
        }

        .btn-back {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid #333;
            border-radius: 40px;
            padding: 10px 24px;
            color: #ffffff;
            font-size: 0.9rem;
            cursor: pointer;
            transition: all 0.3s ease;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 10px;
        }

        .btn-back:hover {
            background: rgba(255, 255, 255, 0.1);
            border-color: #3b82f6;
            transform: translateX(-3px);
        }

        .calendar-wrapper {
            background: #1a1a1a;
            border-radius: 16px;
            padding: 40px 30px;
            text-align: center;
            border: 1px solid #333;
        }

        .calendar-wrapper .icono {
            font-size: 3rem;
            color: #3b82f6;
            margin-bottom: 16px;
        }

        .calendar-wrapper h2 {
            font-weight: 300;
            font-size: 1.5rem;
            margin-bottom: 8px;
        }

        .calendar-wrapper .descripcion {
            color: #888;
            font-size: 1rem;
            margin-bottom: 10px;
        }

        .calendar-nav {
            display: flex;
            justify-content: space-between;
            align-items: center;
            max-width: 500px;
            margin: 0 auto 20px;
            padding: 0 10px;
        }

        .calendar-nav button {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid #333;
            border-radius: 8px;
            color: white;
            padding: 8px 16px;
            cursor: pointer;
            transition: all 0.3s ease;
            font-size: 0.9rem;
        }

        .calendar-nav button:hover {
            background: rgba(255, 255, 255, 0.1);
            border-color: #3b82f6;
        }

        .calendar-nav .month-year {
            color: #aaa;
            font-size: 1.1rem;
            font-weight: 300;
        }

        .calendar-table {
            width: 100%;
            max-width: 500px;
            margin: 0 auto;
            border-collapse: collapse;
        }

        .calendar-table th {
            color: #666;
            font-size: 0.8rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 1px;
            padding: 10px 8px;
            border-bottom: 1px solid #333;
        }

        .calendar-table td {
            padding: 12px 8px;
            text-align: center;
            font-size: 1rem;
            border-bottom: 1px solid #222;
            transition: all 0.2s ease;
            border-radius: 4px;
        }

        .calendar-table td.available {
            color: #4ade80;
            background: rgba(74, 222, 128, 0.05);
        }

        .calendar-table td.available:hover {
            background: rgba(74, 222, 128, 0.15);
            transform: scale(1.05);
            cursor: pointer;
        }

        .calendar-table td.partial {
            color: #fbbf24;
            background: rgba(251, 191, 36, 0.05);
        }

        .calendar-table td.partial:hover {
            background: rgba(251, 191, 36, 0.15);
            transform: scale(1.05);
            cursor: pointer;
        }

        .calendar-table td.unavailable {
            color: #f87171;
            background: rgba(248, 113, 113, 0.05);
            cursor: not-allowed;
        }

        .calendar-table td.past {
            color: #333;
            cursor: not-allowed;
            opacity: 0.3;
        }

        .calendar-table td.empty {
            color: #333;
        }

        .legend {
            display: flex;
            justify-content: center;
            gap: 30px;
            margin-top: 25px;
            font-size: 0.9rem;
            flex-wrap: wrap;
        }

        .legend-item {
            display: flex;
            align-items: center;
            gap: 8px;
            color: #aaa;
        }

        .legend-dot {
            width: 12px;
            height: 12px;
            border-radius: 50%;
            display: inline-block;
        }

        .legend-dot.green {
            background: #4ade80;
        }

        .legend-dot.yellow {
            background: #fbbf24;
        }

        .legend-dot.red {
            background: #f87171;
        }

        .contact-wrapper {
            margin-top: 50px;
            border-top: 1px solid #333;
            padding-top: 40px;
        }

        @media (max-width: 640px) {
            .container {
                padding: 20px 12px;
            }

            .header-calendar {
                flex-direction: column;
                gap: 16px;
                align-items: flex-start;
            }

            .header-calendar h1 {
                font-size: 1.5rem;
            }

            .calendar-wrapper {
                padding: 24px 16px;
            }

            .calendar-table td {
                padding: 8px 4px;
                font-size: 0.85rem;
            }

            .calendar-table th {
                font-size: 0.7rem;
                padding: 8px 4px;
            }

            .legend {
                gap: 16px;
                font-size: 0.8rem;
            }

            .calendar-nav .month-year {
                font-size: 0.9rem;
            }

            .calendar-nav button {
                padding: 6px 12px;
                font-size: 0.8rem;
            }

            .contact-wrapper {
                margin-top: 30px;
                padding-top: 30px;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header-calendar">
            <h1>
                <i class="fas fa-calendar-alt"></i>
                Disponibilidad
            </h1>
            <a href="/" class="btn-back">
                <i class="fas fa-arrow-left"></i>
                Volver al portafolio
            </a>
        </div>

        <div class="calendar-wrapper">
            <div class="icono">
                <i class="fas fa-calendar-check"></i>
            </div>
            <h2>Calendario de Sesiones</h2>
            <p class="descripcion">
                Selecciona una fecha disponible para tu sesión de fotografía
            </p>

            <div class="calendar-nav">
                <button id="pubPrevMonth">‹</button>
                <span class="month-year" id="pubMonthYear">Agosto 2026</span>
                <button id="pubNextMonth">›</button>
            </div>

            <table class="calendar-table" id="pubCalendarTable">
                <thead>
                    <tr>
                        <th>LUN</th>
                        <th>MAR</th>
                        <th>MIÉ</th>
                        <th>JUE</th>
                        <th>VIE</th>
                        <th>SÁB</th>
                        <th>DOM</th>
                    </tr>
                </thead>
                <tbody id="pubCalendarBody">
                    <!-- Generado por JavaScript -->
                </tbody>
            </table>

            <div class="legend">
                <div class="legend-item">
                    <span class="legend-dot green"></span>
                    Disponible
                </div>
                <div class="legend-item">
                    <span class="legend-dot yellow"></span>
                    Disponibilidad parcial
                </div>
                <div class="legend-item">
                    <span class="legend-dot red"></span>
                    No disponible
                </div>
            </div>
        </div>

        <div class="contact-wrapper">
            <ContactForm />
        </div>
    </div>

    <script>
        // Datos desde el backend
        const fechasDisponibilidad = JSON.parse('{JSON.stringify(disponibilidadData.fechas)}');
        const hoy = new Date();
        const currentYear = hoy.getFullYear();
        const currentMonth = hoy.getMonth();
        const currentDay = hoy.getDate();
        
        const maxMonthGlobal = currentMonth + 6;
        const maxYearGlobal = currentYear + Math.floor(maxMonthGlobal / 12);
        const maxMonthFinal = maxMonthGlobal % 12;
        
        let viewYear = currentYear;
        let viewMonth = currentMonth;
        
        function getEstadoFecha(year, month, day) {
            const key = `${year}-${String(month + 1).padStart(2, '0')}-${String(day).padStart(2, '0')}`;
            return fechasDisponibilidad[key] || 'available';
        }
        
        function renderPublicCalendar(year, month) {
            const months = ['Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio', 
                           'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre'];
            
            document.getElementById('pubMonthYear').textContent = `${months[month]} ${year}`;
            
            const firstDay = new Date(year, month, 1).getDay();
            let startOffset = (firstDay === 0) ? 6 : firstDay - 1;
            const daysInMonth = new Date(year, month + 1, 0).getDate();
            
            let html = '';
            let dayCount = 1;
            
            for (let row = 0; row < 6; row++) {
                html += '<tr>';
                for (let col = 0; col < 7; col++) {
                    if (row === 0 && col < startOffset) {
                        html += `<td class="empty"></td>`;
                    } else if (dayCount > daysInMonth) {
                        html += `<td class="empty"></td>`;
                    } else {
                        const dateObj = new Date(year, month, dayCount);
                        const isPast = dateObj < new Date(currentYear, currentMonth, currentDay);
                        const isBeyond = (year > maxYearGlobal) || (year === maxYearGlobal && month > maxMonthFinal);
                        
                        let className = '';
                        let clickable = '';
                        
                        if (isPast || isBeyond) {
                            className = 'past';
                        } else {
                            const estado = getEstadoFecha(year, month, dayCount);
                            className = estado;
                            if (estado !== 'unavailable' && estado !== 'past') {
                                clickable = `onclick="selectPublicDate(${dayCount}, '${months[month]}', ${year})" style="cursor:pointer;"`;
                            }
                        }
                        
                        html += `<td class="${className}" ${clickable}>${dayCount}</td>`;
                        dayCount++;
                    }
                }
                html += '</tr>';
                if (dayCount > daysInMonth) break;
            }
            
            document.getElementById('pubCalendarBody').innerHTML = html;
        }
        
        function selectPublicDate(day, month, year) {
            const dateStr = `${day} de ${month}, ${year}`;
            const dateInput = document.querySelector('#date');
            if (dateInput) {
                const monthNum = new Date(`${month} 1, ${year}`).getMonth() + 1;
                const monthStr = monthNum.toString().padStart(2, '0');
                const dayStr = day.toString().padStart(2, '0');
                dateInput.value = `${year}-${monthStr}-${dayStr}`;
                
                const form = dateInput.closest('form');
                if (form) {
                    form.scrollIntoView({ behavior: 'smooth', block: 'center' });
                }
                showNotification(`📅 Fecha seleccionada: ${dateStr}`);
            }
        }
        
        function showNotification(message) {
            const existing = document.querySelector('.date-notification');
            if (existing) existing.remove();
            
            const notif = document.createElement('div');
            notif.className = 'date-notification';
            notif.style.cssText = `
                position: fixed;
                top: 20px;
                left: 50%;
                transform: translateX(-50%);
                background: #1a3a2a;
                color: #4ade80;
                padding: 12px 24px;
                border-radius: 12px;
                border: 1px solid #2a5a3a;
                font-size: 1rem;
                z-index: 10000;
                opacity: 0;
                transition: opacity 0.3s ease;
                box-shadow: 0 4px 20px rgba(0,0,0,0.5);
            `;
            notif.textContent = message;
            document.body.appendChild(notif);
            
            setTimeout(() => { notif.style.opacity = '1'; }, 10);
            setTimeout(() => {
                notif.style.opacity = '0';
                setTimeout(() => notif.remove(), 300);
            }, 3000);
        }
        
        window.selectPublicDate = selectPublicDate;
        
        document.getElementById('pubPrevMonth').addEventListener('click', () => {
            if (viewMonth === 0) { viewYear--; viewMonth = 11; }
            else { viewMonth--; }
            renderPublicCalendar(viewYear, viewMonth);
        });
        
        document.getElementById('pubNextMonth').addEventListener('click', () => {
            const nextMonthCheck = viewMonth + 1;
            const nextYearCheck = viewYear + Math.floor(nextMonthCheck / 12);
            const nextMonthFinal = nextMonthCheck % 12;
            
            if (nextYearCheck > maxYearGlobal || 
                (nextYearCheck === maxYearGlobal && nextMonthFinal > maxMonthFinal)) {
                showNotification('📅 No hay más fechas disponibles para los próximos 6 meses');
                return;
            }
            
            if (viewMonth === 11) { viewYear++; viewMonth = 0; }
            else { viewMonth++; }
            renderPublicCalendar(viewYear, viewMonth);
        });
        
        // Render inicial
        renderPublicCalendar(viewYear, viewMonth);
    </script>
</body>
</html>
