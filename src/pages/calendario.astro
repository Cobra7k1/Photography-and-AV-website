<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Calendario - Reflections Audio Visual</title>
    <!-- Font Awesome para íconos -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: #0a0a0a;
            color: #ffffff;
            min-height: 100vh;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 40px 20px;
        }

        .header-calendar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding-bottom: 30px;
            border-bottom: 1px solid #333;
            margin-bottom: 40px;
        }

        .header-calendar h1 {
            font-size: 2.5rem;
            font-weight: 300;
            letter-spacing: 2px;
        }

        .header-calendar h1 i {
            color: #3b82f6;
            margin-right: 12px;
        }

        .btn-back {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid #333;
            border-radius: 40px;
            padding: 10px 24px;
            color: #ffffff;
            font-size: 1rem;
            cursor: pointer;
            transition: all 0.3s ease;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 10px;
        }

        .btn-back:hover {
            background: rgba(255, 255, 255, 0.1);
            border-color: #3b82f6;
            transform: translateX(-3px);
        }

        .calendar-placeholder {
            background: #1a1a1a;
            border-radius: 16px;
            padding: 60px 40px;
            text-align: center;
            border: 1px dashed #333;
        }

        .calendar-placeholder i {
            font-size: 4rem;
            color: #3b82f6;
            margin-bottom: 20px;
        }

        .calendar-placeholder h2 {
            font-weight: 300;
            font-size: 1.8rem;
            margin-bottom: 12px;
        }

        .calendar-placeholder p {
            color: #888;
            font-size: 1.1rem;
        }

        .days-grid {
            display: grid;
            grid-template-columns: repeat(7, 1fr);
            gap: 8px;
            margin-top: 30px;
            max-width: 700px;
            margin-left: auto;
            margin-right: auto;
        }

        .day-cell {
            background: #222;
            padding: 12px 8px;
            border-radius: 8px;
            text-align: center;
            font-size: 0.9rem;
            color: #aaa;
            transition: all 0.2s ease;
        }

        .day-cell.available {
            background: #1a3a2a;
            color: #4ade80;
            border: 1px solid #2a5a3a;
        }

        .day-cell.unavailable {
            background: #3a1a1a;
            color: #f87171;
            border: 1px solid #5a2a2a;
        }

        .day-cell.available:hover {
            background: #2a5a3a;
            transform: scale(1.05);
        }

        .day-label {
            color: #666;
            font-size: 0.8rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 1px;
            text-align: center;
            padding: 8px 0;
        }

        .legend {
            display: flex;
            justify-content: center;
            gap: 30px;
            margin-top: 20px;
            font-size: 0.9rem;
            flex-wrap: wrap;
        }

        .legend-item {
            display: flex;
            align-items: center;
            gap: 8px;
            color: #aaa;
        }

        .legend-dot {
            width: 14px;
            height: 14px;
            border-radius: 4px;
        }

        .legend-dot.green {
            background: #4ade80;
        }
        .legend-dot.red {
            background: #f87171;
        }

        @media (max-width: 768px) {
            .header-calendar {
                flex-direction: column;
                gap: 16px;
                align-items: flex-start;
            }

            .header-calendar h1 {
                font-size: 1.8rem;
            }

            .calendar-placeholder {
                padding: 30px 20px;
            }

            .days-grid {
                gap: 4px;
            }

            .day-cell {
                padding: 8px 4px;
                font-size: 0.75rem;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header-calendar">
            <h1>
                <i class="fas fa-calendar-alt"></i>
                Disponibilidad
            </h1>
            <a href="/" class="btn-back">
                <i class="fas fa-arrow-left"></i>
                Volver al portafolio
            </a>
        </div>

        <div class="calendar-placeholder">
            <i class="fas fa-calendar-check"></i>
            <h2>Calendario de Sesiones</h2>
            <p>Selecciona una fecha disponible para tu sesión de fotografía</p>

            <div class="days-grid">
                <div class="day-label">Lun</div>
                <div class="day-label">Mar</div>
                <div class="day-label">Mié</div>
                <div class="day-label">Jue</div>
                <div class="day-label">Vie</div>
                <div class="day-label">Sáb</div>
                <div class="day-label">Dom</div>

                <div class="day-cell">1</div>
                <div class="day-cell available">2</div>
                <div class="day-cell">3</div>
                <div class="day-cell unavailable">4</div>
                <div class="day-cell available">5</div>
                <div class="day-cell">6</div>
                <div class="day-cell">7</div>

                <div class="day-cell available">8</div>
                <div class="day-cell">9</div>
                <div class="day-cell available">10</div>
                <div class="day-cell">11</div>
                <div class="day-cell unavailable">12</div>
                <div class="day-cell available">13</div>
                <div class="day-cell">14</div>
            </div>

            <div class="legend">
                <div class="legend-item">
                    <span class="legend-dot green"></span>
                    Disponible
                </div>
                <div class="legend-item">
                    <span class="legend-dot red"></span>
                    No disponible
                </div>
            </div>
        </div>
    </div>
</body>
</html>
