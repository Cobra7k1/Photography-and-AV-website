---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Galería de Fotos | Reflections Audio Visual</title>
    <meta name="description" content="Galería de fotos de bodas, retratos y propuestas de matrimonio en Salt Lake City y Dallas. Fotografía profesional de Reflections Audio Visual." />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />
    <style>
      * { margin: 0; padding: 0; box-sizing: border-box; }
      body {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        background: #0a0a0a;
        color: #ffffff;
        min-height: 100vh;
        padding: 40px 20px;
      }
      .container { max-width: 1400px; margin: 0 auto; }

      .header-galeria {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 10px;
        flex-wrap: wrap;
        gap: 20px;
      }
      h1 { font-size: 2.5rem; font-weight: 300; letter-spacing: 2px; margin-bottom: 10px; }
      .subtitulo {
        color: #888;
        font-size: 1.2rem;
        margin-bottom: 40px;
        border-bottom: 1px solid #333;
        padding-bottom: 20px;
      }

      .btn-volver {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 12px 24px;
        background: transparent;
        color: #ffffff;
        border: 1px solid #333;
        border-radius: 50px;
        text-decoration: none;
        font-size: 0.95rem;
        font-weight: 500;
        transition: all 0.3s ease;
        cursor: pointer;
      }
      .btn-volver:hover {
        background: #ffffff;
        color: #0a0a0a;
        border-color: #ffffff;
        transform: translateX(-4px);
      }
      .btn-volver i { font-size: 1rem; transition: transform 0.3s ease; }
      .btn-volver:hover i { transform: translateX(-4px); }

      /* ========================================== */
      /* 🎨 ESTILO MASONRY (PINTEREST STYLE)      */
      /* ========================================== */
      .galeria {
        column-count: 4;
        column-gap: 16px;
        margin-top: 20px;
      }

      .galeria-item {
        break-inside: avoid;
        margin-bottom: 16px;
        overflow: hidden;
        border-radius: 12px;
        background: #1a1a1a;
        transition: transform 0.3s ease;
      }

      .galeria-item:hover {
        transform: scale(1.02);
      }

      .galeria-item img {
        width: 100%;
        height: auto;
        display: block;
        transition: transform 0.3s ease;
      }

      .galeria-item:hover img {
        transform: scale(1.03);
      }

      /* ===== RESPONSIVE ===== */
      @media (max-width: 1200px) {
        .galeria { column-count: 3; }
      }

      @media (max-width: 768px) {
        .galeria { column-count: 2; column-gap: 10px; }
        .galeria-item { margin-bottom: 10px; }
        h1 { font-size: 1.8rem; }
        .header-galeria { flex-direction: column; align-items: flex-start; }
        .btn-volver { width: 100%; justify-content: center; }
      }

      @media (max-width: 480px) {
        .galeria { column-count: 1; }
        .galeria-item { margin-bottom: 12px; }
      }
    </style>
  </head>
  <body>
    <div class="container">
      <div class="header-galeria">
        <h1>📸 Galería de Fotos</h1>
        <a href="/" class="btn-volver">
          <i class="fas fa-arrow-left"></i> Volver al inicio
        </a>
      </div>
      <p class="subtitulo">Mis mejores fotografías de bodas, retratos y propuestas en Salt Lake City</p>
      <div class="galeria">
        {fotos.map((foto) => (
          <div class="galeria-item">
            <Image
              src={foto.src}
              alt={foto.alt}
              width={400}
              fit="contain"
              quality={80}
              loading="lazy"
              format="webp"
            />
          </div>
        ))}
      </div>
    </div>
  </body>
</html>
 