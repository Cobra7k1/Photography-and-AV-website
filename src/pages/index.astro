---
// Esto es la "frontera" (frontmatter) de Astro
// Aquí puedes poner lógica, pero por ahora lo dejamos vacío
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Reflections Audio Visual - Fotografía y Video Profesional</title>
    
    <!-- ===== FONT AWESOME PARA ÍCONOS ===== -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    
    <!-- ========================================== -->
    <!-- 🔤 FUENTE MANROPE - IMPORTADA DESDE GOOGLE -->
    <!-- ========================================== -->
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@200;300;400;500;600;700;800&display=swap" rel="stylesheet">
    
    <style>
      /* ========================================== */
      /* 📏 SISTEMA DE TAMAÑOS - MANROPE          */
      /* ========================================== */
      
      /* Títulos principales - Ultraligeros y elegantes */
      h1 {
        font-family: 'Manrope', sans-serif;
        font-weight: 200;
        font-size: 4rem;
        letter-spacing: 2px;
        line-height: 1.1;
        color: #f5f3f0;
        margin-bottom: 10px;
      }

      /* Subtítulos */
      h2 {
        font-family: 'Manrope', sans-serif;
        font-weight: 300;
        font-size: 2.8rem;
        line-height: 1.2;
        color: #ece8e4;
      }

      /* Encabezados de sección */
      h3 {
        font-family: 'Manrope', sans-serif;
        font-weight: 400;
        font-size: 2rem;
        line-height: 1.3;
        color: #f0ede8;
      }

      /* ========================================== */
      /* 🎨 ESTILOS DEL PORTAFOLIO                */
      /* ========================================== */
      * { margin: 0; padding: 0; box-sizing: border-box; }
      
      body {
        font-family: 'Manrope', sans-serif;
        font-weight: 300;
        background: #0a0a0a;
        color: #ece8e4;
        min-height: 100vh;
        padding: 40px 20px;
      }
      
      .container {
        max-width: 1200px;
        margin: 0 auto;
      }
      
      .subtitulo {
        font-family: 'Manrope', sans-serif;
        font-weight: 200;
        font-style: italic;
        font-size: 1.3rem;
        color: #d5d0ca;
        margin-bottom: 40px;
        border-bottom: 1px solid #2a2a2a;
        padding-bottom: 20px;
        letter-spacing: 0.5px;
      }
      
      .galeria {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 20px;
      }
      
      .galeria-item {
        position: relative;
        overflow: hidden;
        border-radius: 12px;
        background: #1a1a1a;
        aspect-ratio: 4 / 3;
        cursor: pointer;
      }
      
      .galeria-item a {
        display: block;
        width: 100%;
        height: 100%;
        text-decoration: none;
      }
      
      .galeria-item img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.3s ease;
      }
      
      .galeria-item:hover img {
        transform: scale(1.05);
      }
      
      /* ========================================== */
      /* 🔥 OVERLAY - SIEMPRE VISIBLE CON MANROPE */
      /* ========================================== */
      .galeria-item .overlay {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        padding: 24px;
        background: linear-gradient(transparent, rgba(0,0,0,0.85));
        opacity: 1;
        transition: opacity 0.3s ease;
        pointer-events: none;
      }
      
      .galeria-item .overlay h3 {
        font-family: 'Manrope', sans-serif;
        font-weight: 300;
        font-size: 1.4rem;
        letter-spacing: 1px;
        color: #f5f3f0;
        text-shadow: 0 2px 12px rgba(0,0,0,0.8);
      }
      
      /* Mensaje si no hay fotos */
      .sin-fotos {
        text-align: center;
        padding: 60px 20px;
        color: #8a8580;
        border: 2px dashed #2a2a2a;
        border-radius: 16px;
        grid-column: 1 / -1;
        font-family: 'Manrope', sans-serif;
        font-weight: 300;
      }
      
      .sin-fotos span {
        font-size: 3rem;
        display: block;
        margin-bottom: 16px;
        color: #8a8580;
      }
      
      .sin-fotos code {
        font-family: 'Manrope', sans-serif;
        font-weight: 400;
        background: #1a1a1a;
        padding: 2px 8px;
        border-radius: 4px;
        color: #b5aea6;
      }

      /* ========================================== */
      /* 🔘 BOTÓN DEL CALENDARIO CON MANROPE      */
      /* ========================================== */
      .btn-calendar-float {
        position: fixed;
        top: 24px;
        right: 24px;
        background: #2a2a2a;
        border: 1px solid #3a3a3a;
        border-radius: 50px;
        padding: 14px 28px 14px 24px;
        display: flex;
        align-items: center;
        gap: 12px;
        color: #f5f3f0;
        font-family: 'Manrope', sans-serif;
        font-weight: 500;
        font-size: 1rem;
        letter-spacing: 0.5px;
        text-decoration: none;
        cursor: pointer;
        transition: all 0.3s ease;
        z-index: 9999;
        box-shadow: 0 4px 20px rgba(0,0,0,0.5);
      }

      .btn-calendar-float i {
        font-size: 1.4rem;
        color: #d5d0ca;
        transition: transform 0.3s ease;
      }

      .btn-calendar-float:hover {
        background: #3a3a3a;
        border-color: #5a5a5a;
        transform: scale(1.05) translateY(-2px);
        box-shadow: 0 8px 30px rgba(0,0,0,0.6);
      }

      .btn-calendar-float:hover i {
        transform: rotate(10deg) scale(1.1);
        color: #f5f3f0;
      }

      .btn-calendar-float:active {
        transform: scale(0.95);
      }

      /* Ajuste para móviles */
      @media (max-width: 640px) {
        .btn-calendar-float {
          top: 16px;
          right: 16px;
          padding: 12px 18px 12px 16px;
          font-size: 0.85rem;
        }
        
        .btn-calendar-float span {
          display: none;
        }
        
        .btn-calendar-float i {
          font-size: 1.3rem;
          margin: 0;
        }
        
        h1 {
          font-size: 2.5rem;
        }
        
        .subtitulo {
          font-size: 1rem;
        }
        
        .galeria-item .overlay h3 {
          font-size: 1.1rem;
        }
      }
    </style>
  </head>
  <body>
    <!-- ========================================== -->
    <!-- 🔘 BOTÓN DEL CALENDARIO                    -->
    <!-- ========================================== -->
    <a href="/calendario" class="btn-calendar-float">
      <i class="fas fa-calendar-alt"></i>
      <span>Agendar sesión</span>
    </a>

    <!-- ========================================== -->
    <!-- 📸 CONTENIDO PRINCIPAL                    -->
    <!-- ========================================== -->
    <div class="container">
      <h1>Reflections Audio and Visual</h1>
      <p class="subtitulo">Photography · Video · Music Production</p>

      <div class="galeria">
        <div class="galeria-item">
          <a href="/galeria-fotos" style="display: block; width: 100%; height: 100%; text-decoration: none;">
            <img src="/foto1.jpg" alt="Galería de Fotografía" />
            <div class="overlay">
              <h3>Photography</h3>
            </div>
          </a>
        </div>
        
        <div class="galeria-item">
          <a href="/galeria-videos" style="display: block; width: 100%; height: 100%; text-decoration: none;">
            <img src="/foto2.jpg" alt="Galería de Videos" />
            <div class="overlay">
              <h3>Professional Video</h3>
            </div>
          </a>
        </div>
        
        <div class="galeria-item">
          <a href="/galeria-audio" style="display: block; width: 100%; height: 100%; text-decoration: none;">
            <img src="/foto3.jpg" alt="Galería de Audio" />
            <div class="overlay">
              <h3>For Musicians · Pro Audio & Video</h3>
            </div>
          </a>
        </div>
      </div>

      <!-- Mensaje de ayuda (se oculta cuando agregues fotos) -->
      <div class="sin-fotos" id="mensaje-ayuda">
        <span>🖼️</span>
        <p>Agrega tus fotos en la carpeta <code>public/</code> y actualiza el código con los nombres de los archivos.</p>
        <p style="margin-top: 10px; font-size: 0.9rem; color: #6a6560;">
          Edita este archivo en <code>src/pages/index.astro</code>
        </p>
      </div>
    </div>

    <script>
      // Esto oculta el mensaje de ayuda si hay imágenes cargadas
      document.addEventListener('DOMContentLoaded', () => {
        const imagenes = document.querySelectorAll('.galeria img');
        const mensajeAyuda = document.getElementById('mensaje-ayuda');
        if (imagenes.length > 0) {
          mensajeAyuda.style.display = 'none';
        }
      });
    </script>

    <!-- ============================================ -->
    <!-- 💬 WIDGET DE CHAT - REFLECTIONS AUDIO VISUAL -->
    <!-- ============================================ -->
    <div id="chat-widget" style="position:fixed; bottom:20px; right:20px; z-index:9999; font-family:'Manrope', sans-serif;">
      
      <!-- Botón para abrir/cerrar -->
      <button id="chat-toggle" style="
        background: #1a1a1a; 
        color: #ece8e4; 
        border: 1px solid #2a2a2a;
        border-radius: 50%;
        width: 60px; 
        height: 60px; 
        font-size: 28px; 
        cursor: pointer; 
        box-shadow: 0 4px 16px rgba(0,0,0,0.3);
        transition: transform 0.3s ease;
      ">
        💬
      </button>
      
      <!-- Ventana de chat (oculta por defecto) -->
      <div id="chat-window" style="
        display: none; 
        position: absolute; 
        bottom: 70px; 
        right: 0;
        width: 380px; 
        height: 520px; 
        background: #141414; 
        border-radius: 16px;
        border: 1px solid #2a2a2a;
        box-shadow: 0 8px 40px rgba(0,0,0,0.5); 
        overflow: hidden;
        flex-direction: column;
        font-family: 'Manrope', sans-serif;
      ">
        <!-- Header -->
        <div style="
          background: #1a1a1a; 
          color: #f5f3f0; 
          padding: 16px 20px; 
          font-weight: 400;
          display: flex;
          align-items: center;
          gap: 10px;
          font-family: 'Manrope', sans-serif;
          border-bottom: 1px solid #2a2a2a;
        ">
          <span style="font-size: 20px;">📸</span>
          <div>
            <div style="font-size: 16px; font-weight: 500; letter-spacing: 0.5px;">Asistente de Reflections</div>
            <div style="font-size: 12px; opacity: 0.6; font-weight: 200; font-style: italic; color: #d5d0ca;">Pregúntame lo que necesites</div>
          </div>
          <button id="chat-close" style="
            margin-left: auto;
            background: none;
            border: none;
            color: #d5d0ca;
            font-size: 20px;
            cursor: pointer;
            transition: color 0.3s;
          "
          onmouseover="this.style.color='#f5f3f0'"
          onmouseout="this.style.color='#d5d0ca'"
          >✕</button>
        </div>
        
        <!-- Área de mensajes -->
        <div id="chat-messages" style="
          flex: 1; 
          padding: 16px; 
          overflow-y: auto; 
          background: #0a0a0a;
          font-family: 'Manrope', sans-serif;
          font-weight: 300;
        ">
          <div style="text-align: center; color: #8a8580; font-size: 14px; padding: 20px 0; font-style: italic;">
            Hola, soy el asistente de Reflections Audio Visual<br>
            ¿En qué puedo ayudarte?
          </div>
        </div>
        
        <!-- Input -->
        <div style="
          display: flex; 
          border-top: 1px solid #2a2a2a; 
          padding: 12px 16px; 
          gap: 8px;
          background: #0a0a0a;
        ">
          <input 
            id="chat-input" 
            type="text" 
            placeholder="Escribe tu mensaje..." 
            style="
              flex: 1; 
              padding: 10px 14px; 
              border: 1px solid #2a2a2a; 
              border-radius: 8px; 
              outline: none;
              font-size: 14px;
              font-family: 'Manrope', sans-serif;
              font-weight: 300;
              background: #1a1a1a;
              color: #ece8e4;
              transition: border 0.3s;
            "
            onfocus="this.style.borderColor='#4a4a4a'"
            onblur="this.style.borderColor='#2a2a2a'"
          >
          <button id="chat-send" style="
            background: #2a2a2a; 
            color: #f5f3f0; 
            border: 1px solid #3a3a3a;
            padding: 10px 20px; 
            border-radius: 8px; 
            cursor: pointer;
            font-size: 14px;
            font-weight: 500;
            font-family: 'Manrope', sans-serif;
            transition: all 0.3s;
          "
          onmouseover="this.style.background='#3a3a3a'; this.style.borderColor='#5a5a5a'"
          onmouseout="this.style.background='#2a2a2a'; this.style.borderColor='#3a3a3a'"
          >
            Enviar
          </button>
        </div>
      </div>
    </div>

    <script>
      // ============================================
      // 🎯 LÓGICA DEL CHAT
      // ============================================
      const toggleBtn = document.getElementById('chat-toggle');
      const closeBtn = document.getElementById('chat-close');
      const chatWindow = document.getElementById('chat-window');
      const messagesDiv = document.getElementById('chat-messages');
      const input = document.getElementById('chat-input');
      const sendBtn = document.getElementById('chat-send');

      // Abrir/cerrar chat
      toggleBtn.addEventListener('click', () => {
        const isOpen = chatWindow.style.display === 'flex';
        chatWindow.style.display = isOpen ? 'none' : 'flex';
      });

      closeBtn.addEventListener('click', () => {
        chatWindow.style.display = 'none';
      });

      // Función para enviar mensaje
      async function sendMessage(text) {
        if (!text.trim()) return;
        
        // Agregar mensaje del usuario
        const userMsg = document.createElement('div');
        userMsg.style.cssText = 'text-align: right; margin: 8px 0;';
        userMsg.innerHTML = `<span style="background: #2a2a2a; color: #f5f3f0; padding: 10px 14px; border-radius: 16px; display: inline-block; max-width: 80%; font-size: 14px; font-family: 'Manrope', sans-serif; font-weight: 300;">${text}</span>`;
        messagesDiv.appendChild(userMsg);
        
        input.value = '';
        messagesDiv.scrollTop = messagesDiv.scrollHeight;

        // Indicador de "escribiendo..."
        const typing = document.createElement('div');
        typing.style.cssText = 'margin: 8px 0; color: #8a8580; font-size: 14px; font-style: italic; font-family: "Manrope", sans-serif; font-weight: 200;';
        typing.textContent = 'Escribiendo...';
        messagesDiv.appendChild(typing);
        messagesDiv.scrollTop = messagesDiv.scrollHeight;

        try {
          // ✅ URL CORRECTA para Netlify Functions
          const response = await fetch('/.netlify/functions/chat', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ 
              messages: [{ role: 'user', content: text }] 
            })
          });

          if (!response.ok) {
            const errorData = await response.json();
            throw new Error(errorData.error || 'Error en el servidor');
          }
          
          messagesDiv.removeChild(typing);
          
          const reader = response.body.getReader();
          const decoder = new TextDecoder();
          let fullResponse = '';
          
          const assistantMsg = document.createElement('div');
          assistantMsg.style.cssText = 'text-align: left; margin: 8px 0;';
          assistantMsg.innerHTML = `<span style="background: #1a1a1a; color: #ece8e4; padding: 10px 14px; border-radius: 16px; display: inline-block; max-width: 80%; font-size: 14px; font-family: 'Manrope', sans-serif; font-weight: 300; border: 1px solid #2a2a2a;"></span>`;
          messagesDiv.appendChild(assistantMsg);
          
          while (true) {
            const { done, value } = await reader.read();
            if (done) break;
            
            const chunk = decoder.decode(value);
            const lines = chunk.split('\n');
            for (const line of lines) {
              if (line.startsWith('data: ')) {
                const data = line.slice(6);
                if (data === '[DONE]') continue;
                try {
                  const parsed = JSON.parse(data);
                  const content = parsed.choices?.[0]?.delta?.content || '';
                  if (content) {
                    fullResponse += content;
                    assistantMsg.querySelector('span').textContent = fullResponse;
                    messagesDiv.scrollTop = messagesDiv.scrollHeight;
                  }
                } catch (e) {
                  // Ignorar errores de parsing
                }
              }
            }
          }
        } catch (error) {
          messagesDiv.removeChild(typing);
          const errorMsg = document.createElement('div');
          errorMsg.style.cssText = 'text-align: center; color: #8a6560; font-size: 13px; margin: 8px 0; font-family: "Manrope", sans-serif; font-weight: 300;';
          errorMsg.textContent = 'Lo siento, hubo un error. Por favor, intenta de nuevo.';
          messagesDiv.appendChild(errorMsg);
        }
        messagesDiv.scrollTop = messagesDiv.scrollHeight;
      }

      // Eventos de envío
      sendBtn.addEventListener('click', () => sendMessage(input.value));
      input.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' && !e.shiftKey) {
          e.preventDefault();
          sendMessage(input.value);
        }
      });
    </script>

  </body>
</html>