---
// Esto es la "frontera" (frontmatter) de Astro
// Aquí puedes poner lógica, pero por ahora lo dejamos vacío
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Reflections Audio Visual - Fotografía y Video Profesional</title>
    
    <!-- ===== FONT AWESOME PARA ÍCONOS ===== -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    
    <style>
      /* ========================================== */
      /* 🎨 ESTILOS DEL PORTAFOLIO                */
      /* ========================================== */
      * { margin: 0; padding: 0; box-sizing: border-box; }
      
      body {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        background: #0a0a0a;
        color: #ffffff;
        min-height: 100vh;
        padding: 40px 20px;
      }
      
      .container {
        max-width: 1200px;
        margin: 0 auto;
      }
      
      h1 {
        font-size: 3rem;
        font-weight: 300;
        letter-spacing: 2px;
        margin-bottom: 10px;
      }
      
      .subtitulo {
        color: #888;
        font-size: 1.2rem;
        margin-bottom: 40px;
        border-bottom: 1px solid #333;
        padding-bottom: 20px;
      }
      
      .galeria {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 20px;
      }
      
      .galeria-item {
        position: relative;
        overflow: hidden;
        border-radius: 12px;
        background: #1a1a1a;
        aspect-ratio: 4 / 3;
      }
      
      .galeria-item img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.3s ease;
      }
      
      .galeria-item:hover img {
        transform: scale(1.05);
      }
      
      .galeria-item .overlay {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        padding: 20px;
        background: linear-gradient(transparent, rgba(0,0,0,0.8));
        opacity: 0;
        transition: opacity 0.3s ease;
      }
      
      .galeria-item:hover .overlay {
        opacity: 1;
      }
      
      .galeria-item .overlay h3 {
        font-size: 1rem;
        font-weight: 400;
      }
      
      /* Mensaje si no hay fotos */
      .sin-fotos {
        text-align: center;
        padding: 60px 20px;
        color: #666;
        border: 2px dashed #333;
        border-radius: 16px;
        grid-column: 1 / -1;
      }
      
      .sin-fotos span {
        font-size: 3rem;
        display: block;
        margin-bottom: 16px;
      }

      /* ========================================== */
      /* 🔘 BOTÓN DEL CALENDARIO - VERSIÓN VISIBLE */
      /* ========================================== */
      .btn-calendar-float {
        position: fixed;
        top: 24px;
        right: 24px;
        background: #3b82f6;  /* ← AZUL VISIBLE */
        border: none;
        border-radius: 50px;
        padding: 14px 28px 14px 24px;
        display: flex;
        align-items: center;
        gap: 12px;
        color: #ffffff;
        font-size: 1rem;
        font-weight: 600;
        text-decoration: none;
        cursor: pointer;
        transition: all 0.3s ease;
        z-index: 9999;
        box-shadow: 0 4px 20px rgba(59, 130, 246, 0.4);
      }

      .btn-calendar-float i {
        font-size: 1.4rem;
        color: #ffffff;
        transition: transform 0.3s ease;
      }

      .btn-calendar-float:hover {
        background: #2563eb;
        transform: scale(1.05) translateY(-2px);
        box-shadow: 0 8px 30px rgba(59, 130, 246, 0.6);
      }

      .btn-calendar-float:hover i {
        transform: rotate(10deg) scale(1.1);
      }

      .btn-calendar-float:active {
        transform: scale(0.95);
      }

      /* Ajuste para móviles */
      @media (max-width: 640px) {
        .btn-calendar-float {
          top: 16px;
          right: 16px;
          padding: 12px 18px 12px 16px;
          font-size: 0.85rem;
        }
        
        .btn-calendar-float span {
          display: none; /* oculta el texto en móvil, solo ícono */
        }
        
        .btn-calendar-float i {
          font-size: 1.3rem;
          margin: 0;
        }
      }
    </style>
  </head>
  <body>
    <!-- ========================================== -->
    <!-- 🔘 BOTÓN DEL CALENDARIO                    -->
    <!-- ========================================== -->
    <a href="/calendario" class="btn-calendar-float">
      <i class="fas fa-calendar-alt"></i>
      <span>Agendar sesión</span>
    </a>

    <!-- ========================================== -->
    <!-- 📸 CONTENIDO PRINCIPAL                    -->
    <!-- ========================================== -->
    <div class="container">
      <h1>📸 Reflections Audio Visual</h1>
      <p class="subtitulo">Fotografía · Video · Momentos inolvidables</p>

      <div class="galeria">
        <!-- 
          📌 AQUÍ VAN TUS FOTOS
          Reemplaza "foto1.jpg", "foto2.jpg", etc. con los nombres
          reales de tus archivos que coloques en la carpeta public/
        -->
        
        <div class="galeria-item">
          <img src="/foto1.jpg" alt="Sesión de fotografía profesional" />
          <div class="overlay">
            <h3>Proyecto Alba</h3>
          </div>
        </div>
        
        <div class="galeria-item">
          <img src="/foto2.jpg" alt="Fotografía de naturaleza" />
          <div class="overlay">
            <h3>Naturaleza viva</h3>
          </div>
        </div>
        
        <div class="galeria-item">
          <img src="/foto3.jpg" alt="Retrato urbano" />
          <div class="overlay">
            <h3>Retratos urbanos</h3>
          </div>
        </div>
      </div>

      <!-- Mensaje de ayuda (se oculta cuando agregues fotos) -->
      <div class="sin-fotos" id="mensaje-ayuda">
        <span>🖼️</span>
        <p>Agrega tus fotos en la carpeta <code>public/</code> y actualiza el código con los nombres de los archivos.</p>
        <p style="margin-top: 10px; font-size: 0.9rem; color: #444;">
          Edita este archivo en <code>src/pages/index.astro</code>
        </p>
      </div>
    </div>

    <script>
      // Esto oculta el mensaje de ayuda si hay imágenes cargadas
      document.addEventListener('DOMContentLoaded', () => {
        const imagenes = document.querySelectorAll('.galeria img');
        const mensajeAyuda = document.getElementById('mensaje-ayuda');
        if (imagenes.length > 0) {
          mensajeAyuda.style.display = 'none';
        }
      });
    </script>

    <!-- ============================================ -->
    <!-- 💬 WIDGET DE CHAT - REFLECTIONS AUDIO VISUAL -->
    <!-- ============================================ -->
    <div id="chat-widget" style="position:fixed; bottom:20px; right:20px; z-index:9999; font-family:'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;">
      
      <!-- Botón para abrir/cerrar -->
      <button id="chat-toggle" style="
        background: #1a1a1a; 
        color: white; 
        border: none; 
        border-radius: 50%;
        width: 60px; 
        height: 60px; 
        font-size: 28px; 
        cursor: pointer; 
        box-shadow: 0 4px 16px rgba(0,0,0,0.3);
        transition: transform 0.3s ease;
      ">
        💬
      </button>
      
      <!-- Ventana de chat (oculta por defecto) -->
      <div id="chat-window" style="
        display: none; 
        position: absolute; 
        bottom: 70px; 
        right: 0;
        width: 380px; 
        height: 520px; 
        background: white; 
        border-radius: 16px;
        box-shadow: 0 8px 40px rgba(0,0,0,0.25); 
        overflow: hidden;
        flex-direction: column;
      ">
        <!-- Header -->
        <div style="
          background: #1a1a1a; 
          color: white; 
          padding: 16px 20px; 
          font-weight: 600;
          display: flex;
          align-items: center;
          gap: 10px;
        ">
          <span style="font-size: 20px;">📸</span>
          <div>
            <div style="font-size: 16px;">Asistente de Reflections</div>
            <div style="font-size: 12px; opacity: 0.7;">¡Pregúntame lo que necesites!</div>
          </div>
          <button id="chat-close" style="
            margin-left: auto;
            background: none;
            border: none;
            color: white;
            font-size: 20px;
            cursor: pointer;
            opacity: 0.7;
          ">✕</button>
        </div>
        
        <!-- Área de mensajes -->
        <div id="chat-messages" style="
          flex: 1; 
          padding: 16px; 
          overflow-y: auto; 
          background: #faf8f5;
        ">
          <div style="text-align: center; color: #999; font-size: 14px; padding: 20px 0;">
            👋 ¡Hola! Soy el asistente de Reflections Audio Visual<br>
            ¿En qué puedo ayudarte hoy?
          </div>
        </div>
        
        <!-- Input -->
        <div style="
          display: flex; 
          border-top: 1px solid #eee; 
          padding: 12px 16px; 
          gap: 8px;
          background: white;
        ">
          <input 
            id="chat-input" 
            type="text" 
            placeholder="Escribe tu mensaje aquí..." 
            style="
              flex: 1; 
              padding: 10px 14px; 
              border: 1px solid #ddd; 
              border-radius: 8px; 
              outline: none;
              font-size: 14px;
              transition: border 0.3s;
            "
            onfocus="this.style.borderColor='#1a1a1a'"
            onblur="this.style.borderColor='#ddd'"
          >
          <button id="chat-send" style="
            background: #1a1a1a; 
            color: white; 
            border: none; 
            padding: 10px 20px; 
            border-radius: 8px; 
            cursor: pointer;
            font-size: 14px;
            font-weight: 500;
            transition: background 0.3s;
          ">
            Enviar
          </button>
        </div>
      </div>
    </div>

    <script>
      // ============================================
      // 🎯 LÓGICA DEL CHAT
      // ============================================
      const toggleBtn = document.getElementById('chat-toggle');
      const closeBtn = document.getElementById('chat-close');
      const chatWindow = document.getElementById('chat-window');
      const messagesDiv = document.getElementById('chat-messages');
      const input = document.getElementById('chat-input');
      const sendBtn = document.getElementById('chat-send');

      // Abrir/cerrar chat
      toggleBtn.addEventListener('click', () => {
        const isOpen = chatWindow.style.display === 'flex';
        chatWindow.style.display = isOpen ? 'none' : 'flex';
      });

      closeBtn.addEventListener('click', () => {
        chatWindow.style.display = 'none';
      });

      // Función para enviar mensaje
      async function sendMessage(text) {
        if (!text.trim()) return;
        
        // Agregar mensaje del usuario
        const userMsg = document.createElement('div');
        userMsg.style.cssText = 'text-align: right; margin: 8px 0;';
        userMsg.innerHTML = `<span style="background: #1a1a1a; color: white; padding: 10px 14px; border-radius: 16px; display: inline-block; max-width: 80%; font-size: 14px;">${text}</span>`;
        messagesDiv.appendChild(userMsg);
        
        input.value = '';
        messagesDiv.scrollTop = messagesDiv.scrollHeight;

        // Indicador de "escribiendo..."
        const typing = document.createElement('div');
        typing.style.cssText = 'margin: 8px 0; color: #999; font-size: 14px;';
        typing.textContent = '✍️ Escribiendo...';
        messagesDiv.appendChild(typing);
        messagesDiv.scrollTop = messagesDiv.scrollHeight;

        try {
          // ✅ URL CORRECTA para Netlify Functions
          const response = await fetch('/.netlify/functions/chat', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ 
              messages: [{ role: 'user', content: text }] 
            })
          });

          if (!response.ok) {
            const errorData = await response.json();
            throw new Error(errorData.error || 'Error en el servidor');
          }
          
          messagesDiv.removeChild(typing);
          
          const reader = response.body.getReader();
          const decoder = new TextDecoder();
          let fullResponse = '';
          
          const assistantMsg = document.createElement('div');
          assistantMsg.style.cssText = 'text-align: left; margin: 8px 0;';
          assistantMsg.innerHTML = `<span style="background: #e8e0d8; color: #1a1a1a; padding: 10px 14px; border-radius: 16px; display: inline-block; max-width: 80%; font-size: 14px;"></span>`;
          messagesDiv.appendChild(assistantMsg);
          
          while (true) {
            const { done, value } = await reader.read();
            if (done) break;
            
            const chunk = decoder.decode(value);
            const lines = chunk.split('\n');
            for (const line of lines) {
              if (line.startsWith('data: ')) {
                const data = line.slice(6);
                if (data === '[DONE]') continue;
                try {
                  const parsed = JSON.parse(data);
                  const content = parsed.choices?.[0]?.delta?.content || '';
                  if (content) {
                    fullResponse += content;
                    assistantMsg.querySelector('span').textContent = fullResponse;
                    messagesDiv.scrollTop = messagesDiv.scrollHeight;
                  }
                } catch (e) {
                  // Ignorar errores de parsing
                }
              }
            }
          }
        } catch (error) {
          messagesDiv.removeChild(typing);
          const errorMsg = document.createElement('div');
          errorMsg.style.cssText = 'text-align: center; color: #e74c3c; font-size: 13px; margin: 8px 0;';
          errorMsg.textContent = '❌ Lo siento, hubo un error. Por favor, intenta de nuevo.';
          messagesDiv.appendChild(errorMsg);
        }
        messagesDiv.scrollTop = messagesDiv.scrollHeight;
      }

      // Eventos de envío
      sendBtn.addEventListener('click', () => sendMessage(input.value));
      input.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' && !e.shiftKey) {
          e.preventDefault();
          sendMessage(input.value);
        }
      });
    </script>

  </body>
</html>
